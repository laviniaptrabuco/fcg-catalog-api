    "Uri": "http://elasticsearch:9200",
    "IndexName": "fcg-games"
  },
  "Cache": {
    "ListTtlSeconds": "300",
    "SearchTtlSeconds": "120"
  },
  "Logging": {
    "LogLevel": {
